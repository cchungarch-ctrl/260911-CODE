@echo off
chcp 65001 >nul
title NexusPM 伺服器關閉程式
cd /d "%~dp0"

echo ====================================================================
echo   NexusPM 營建專案管理系統 - [關閉伺服器]
echo ====================================================================
echo.

set FOUND=0

:: 搜尋監聽在連接埠 3000 的處理程序 PID 並終止
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :3000 ^| findstr LISTENING 2^>nul') do (
    if not "%%a"=="" (
        set FOUND=1
        echo [處理中] 發現佔用連接埠 3000 之處理程序 PID: %%a
        echo [處理中] 正在關閉處理程序 PID: %%a ...
        taskkill /F /PID %%a >nul 2>&1
        if %errorlevel% equ 0 (
            echo [成功] 已終止處理程序 PID: %%a
        ) else (
            echo [提示] 處理程序可能已自行關閉。
        )
    )
)

echo.
if "%FOUND%"=="1" (
    echo ====================================================================
    echo [成功] NexusPM 伺服器已成功關閉，連接埠 3000 已完全釋放！
    echo ====================================================================
) else (
    echo ====================================================================
    echo [資訊] 目前未偵測到佔用連接埠 3000 的伺服器處理程序。
    echo 伺服器目前已處於停止狀態。
    echo ====================================================================
)
echo.
timeout /t 3 >nul
exit /b 0
